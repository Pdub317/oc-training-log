{
  "name": "oc-training-log",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "dev": "pnpm --filter @oc-training-log/admin-web dev",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "supabase": "2.116.0"
  }
}
