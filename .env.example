# Public browser values. These are safe to expose only when RLS policies are active.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never prefix these with NEXT_PUBLIC_ or add them to a client target.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
CRON_SECRET=replace-with-at-least-16-random-characters

# Optional until direct Apple push delivery is enabled. Keep the .p8 key server-only.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Optional during local development.
SENTRY_DSN=
